# Auto detect text files and normalize line endings to LF
* text=auto

# Source files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.exe binary
*.dll binary
*.pak binary

# Scripts de Windows necesitan CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
