---
id: safe-json-reader
category: Sistema de archivos
title: Lector JSON seguro
language: javascript
description: Lee un JSON sin romper la app si falta o está mal formado; quita el BOM y devuelve un valor por defecto.
validate: js
---
const fs = require('fs')

function readJsonSafe(filePath, fallback = null) {
  try {
    return JSON.parse(fs.readFileSync(filePath, 'utf8').replace(/^﻿/, ''))
  } catch (e) {
    console.warn(`No se pudo leer ${filePath}: ${e.message}`)
    return fallback
  }
}
