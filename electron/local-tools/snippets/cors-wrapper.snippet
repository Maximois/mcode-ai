---
id: cors-wrapper
category: Redes y servidores
title: Envoltorio CORS para handlers http
language: javascript
description: Agrega cabeceras CORS a un handler de http.createServer y responde el preflight OPTIONS.
params: origin=http://localhost:5176|Origen permitido
validate: js
---
function withCors(handler, allowedOrigin = '{{origin}}') {
  return (req, res) => {
    res.setHeader('Access-Control-Allow-Origin', allowedOrigin)
    res.setHeader('Access-Control-Allow-Methods', 'GET,POST,PUT,DELETE,OPTIONS')
    res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization')
    if (req.method === 'OPTIONS') { res.writeHead(204); return res.end() }
    return handler(req, res)
  }
}
