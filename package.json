  "private": true,
  "description": "MCodeAI v2 - Editor con IA + Extension Host VSIX by MC SERVICES",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite --port 5176 --strictPort\" \"wait-on http://localhost:5176 && cross-env NODE_ENV=development electron .\"",
