    "@codingame/monaco-vscode-json-language-features-default-extension": "32.0.2",
    "@codingame/monaco-vscode-markdown-language-features-default-extension": "32.0.2",
    "@codingame/monaco-vscode-python-default-extension": "32.0.2",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "32.0.2",
    "@codingame/monaco-vscode-typescript-language-features-default-extension": "32.0.2",
    "@electron/asar": "^3.4.1",
    "adm-zip": "^0.5.17",
    "express": "^5.2.1",
